# ApproveX production Caddyfile: automatic HTTPS for {$APPROVEX_DOMAIN},
# /api/* to the NestJS API, everything else is the SPA (client routing).
{$APPROVEX_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
