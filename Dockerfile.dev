# Dev image — one install, three runtime targets sharing it.
# Production images live in Dockerfile.prod (api/worker) and Dockerfile.web (SPA).
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable pnpm
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm prisma:generate

FROM base AS api
EXPOSE 3000
CMD ["sh", "-c", "pnpm prisma:deploy && pnpm dev:api"]

FROM base AS web
EXPOSE 5173
CMD ["pnpm", "dev:web", "--host"]

FROM base AS worker
CMD ["pnpm", "dev:worker"]
