{
  "name": "@approvex/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @approvex/shared build",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @approvex/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @approvex/shared build",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@approvex/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "catalog:",
    "@sentry/node": "^10.64.0",
    "argon2": "^0.44.0",
    "ioredis": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "prisma": "catalog:",
    "supertest": "^7.0.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.1",
    "vitest": "catalog:"
  }
}
