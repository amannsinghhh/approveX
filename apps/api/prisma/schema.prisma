// ApproveX schema — Phase 1: tenancy, auth, RBAC, audit.
// Every domain table carries tenant_id; isolation is enforced with Postgres RLS
// (policies live in the phase1_rls_audit migration) in addition to application scoping.
// The app connects as the non-owner role `approvex_app` so RLS always applies;
// migrations/auth bootstrap use the owner connection (DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  invited
  deactivated

  @@map("user_status")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum RuleStatus {
  draft
  published
  archived

  @@map("rule_status")
}

/// How a rule version reaches its verdict. A condition_tree carries condition_ast;
/// a scoring version carries scoring_spec (a DB CHECK enforces exactly one).
enum RuleType {
  condition_tree
  scoring

  @@map("rule_type")
}

enum FieldDefType {
  number
  string
  boolean
  date

  @@map("field_def_type")
}

// Provenance of a field's value at evaluate time (addendum B.2).
enum FieldSource {
  payload
  computed
  looked_up

  @@map("field_source")
}

// P0.1 Request Portal: how a user-submittable field renders on the generated
// request form. Decoupled from FieldDefType storage type.
enum FieldInputType {
  text
  number
  currency
  date
  select
  textarea
  checkbox
  file

  @@map("field_input_type")
}

// B.3 #10 — what the API does when an external lookup fails or times out.
// Never a silent pass: treat_as_no_match fails the comparison closed,
// use_cached_value falls back to the last good value (else fails closed),
// block_and_alert refuses to evaluate.
enum LookupFallback {
  treat_as_no_match
  use_cached_value
  block_and_alert

  @@map("lookup_fallback")
}

enum HitPolicy {
  first
  all
  unique
  best

  @@map("hit_policy")
}

enum RejectionPolicy {
  any_reject_kills
  reject_returns_to_previous_step

  @@map("rejection_policy")
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
  expired

  @@map("request_status")
}

enum StepStatus {
  pending
  approved
  rejected
  cancelled
  superseded

  @@map("step_status")
}

enum StepActionType {
  approve
  reject
  delegate
  comment

  @@map("step_action_type")
}

// How an action reached the system. `web` is an authenticated session; `email`
// and `whatsapp` are no-login signed-token approvals; `api` is a machine key;
// `tally` is the ERP connector. Recorded on every action for the audit log and
// the compliance export.
enum ApprovalChannel {
  web
  email
  whatsapp
  api
  tally

  @@map("approval_channel")
}

enum WebhookOutboxStatus {
  pending
  delivering
  delivered
  dead_letter

  @@map("webhook_outbox_status")
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  webhookSecret String   @map("webhook_secret")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users            User[]
  roles            Role[]
  invitations      Invitation[]
  refreshTokens    RefreshToken[]
  auditEvents      AuditEvent[]
  fieldDefinitions      FieldDefinition[]
  rules                 Rule[]
  ruleVersions          RuleVersion[]
  decisionTables        DecisionTable[]
  decisionTableVersions DecisionTableVersion[]
  workflows             Workflow[]
  workflowVersions      WorkflowVersion[]
  ruleWorkflowBindings  RuleWorkflowBinding[]
  requests              Request[]
  requestSteps          RequestStep[]
  stepActions           StepAction[]
  delegations           Delegation[]
  webhookEndpoints      WebhookEndpoint[]
  webhookOutbox         WebhookOutbox[]
  apiKeys               ApiKey[]
  managedLists          ManagedList[]
  approvalTokens        ApprovalToken[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(active)
  settings     Json       @default("{}")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

// Global permission catalog (no tenant_id) — seeded by migration, read-only for the app role.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  email       String
  roleIds     String[]         @map("role_ids") @db.Uuid
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(pending)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedById String           @map("invited_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("invitations")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jtiHash   String    @unique @map("jti_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Per-tenant field registry: drives builder dropdowns and evaluator coercion.
model FieldDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String
  type        FieldDefType
  description String?
  // Addendum B.2 metadata. unit e.g. "currency:INR"; precision = minor-unit
  // digits (currency stored as integer minor units); defaultIfMissing is what
  // the evaluator treats an absent field as; enumValues lists allowed values.
  unit             String?
  precision        Int?
  nullable         Boolean     @default(true)
  defaultIfMissing Json?       @map("default_if_missing")
  source           FieldSource @default(payload)
  enumValues       String[]    @default([]) @map("enum_values")
  // B.3 #10 external lookups — only meaningful when source = looked_up:
  // the outbound HTTP endpoint the value is resolved from + failure policy.
  lookupUrl        String?        @map("lookup_url")
  lookupFallback   LookupFallback @default(treat_as_no_match) @map("lookup_fallback")
  // P0.1 Request Portal. userSubmittable gates a field onto the generated
  // request form; contexts scopes which forms it appears on (empty = none).
  // label/helpText are the human-facing form copy; inputType overrides how the
  // scalar type renders; displayOrder sorts the form (nulls last).
  userSubmittable Boolean         @default(false) @map("user_submittable")
  contexts        String[]        @default([])
  label           String?
  helpText        String?         @map("help_text")
  inputType       FieldInputType? @map("input_type")
  displayOrder    Int?            @map("display_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("field_definitions")
}

model ManagedList {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  values      String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("managed_lists")
}

model Rule {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  name           String
  description    String?
  context        String
  status         RuleStatus @default(draft)
  currentVersion Int        @default(0) @map("current_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  versions RuleVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, context, status])
  @@map("rules")
}

// A version with published_at set is immutable — enforced by a Postgres
// trigger (phase2 migration). Draft versions (published_at null) are editable.
model RuleVersion {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ruleId        String    @map("rule_id") @db.Uuid
  version       Int
  ruleType      RuleType  @default(condition_tree) @map("rule_type")
  /// Set iff ruleType is condition_tree.
  conditionAst  Json?     @map("condition_ast")
  /// Set iff ruleType is scoring: weighted factors + threshold.
  scoringSpec   Json?     @map("scoring_spec")
  priority      Int       @default(100)
  effectiveFrom DateTime? @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedById String?   @map("published_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([tenantId, priority])
  @@index([conditionAst], type: Gin)
  @@map("rule_versions")
}

model DecisionTable {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  name           String
  description    String?
  context        String
  status         RuleStatus @default(draft)
  currentVersion Int        @default(0) @map("current_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  versions DecisionTableVersion[]

  @@unique([tenantId, name])
  @@index([tenantId, context, status])
  @@map("decision_tables")
}

// Same immutability contract as rule_versions (shared trigger function).
model DecisionTableVersion {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tableId       String    @map("table_id") @db.Uuid
  version       Int
  columns       Json
  rows          Json
  hitPolicy     HitPolicy @default(first) @map("hit_policy")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedById String?   @map("published_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  table  DecisionTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, version])
  @@map("decision_table_versions")
}

model Workflow {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  name           String
  description    String?
  status         RuleStatus @default(draft)
  currentVersion Int        @default(0) @map("current_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  versions WorkflowVersion[]
  bindings RuleWorkflowBinding[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("workflows")
}

// Same immutability contract as rule_versions (shared trigger function).
model WorkflowVersion {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  workflowId      String          @map("workflow_id") @db.Uuid
  version         Int
  graph           Json
  rejectionPolicy RejectionPolicy @default(any_reject_kills) @map("rejection_policy")
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  publishedById   String?         @map("published_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  workflow Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requests Request[]

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

// Binding resolves to the workflow's current published version at
// instantiation, then the request pins that version forever.
model RuleWorkflowBinding {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  ruleVersionId String   @unique @map("rule_version_id") @db.Uuid
  workflowId    String   @map("workflow_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("rule_workflow_bindings")
}

model Request {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  externalRef          String?       @map("external_ref")
  context              String?
  title                String?
  payload              Json
  status               RequestStatus @default(pending)
  matchedRuleVersionId String?       @map("matched_rule_version_id") @db.Uuid
  workflowVersionId    String        @map("workflow_version_id") @db.Uuid
  idempotencyKey       String?       @map("idempotency_key")
  createdById          String        @map("created_by_id") @db.Uuid
  /** Engine bookkeeping: completed nodes + delivered edges (pinned graph). */
  engineState          Json          @default("{}") @map("engine_state")
  /** Snapshot returned for idempotent replays. */
  initialResponse      Json?         @map("initial_response")
  /** Set by the worker once the requester was told about the final decision. */
  completionNotifiedAt DateTime?     @map("completion_notified_at") @db.Timestamptz(6)
  completedAt          DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  workflowVersion WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  steps           RequestStep[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, context])
  @@map("requests")
}

model RequestStep {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  requestId          String     @map("request_id") @db.Uuid
  nodeId             String     @map("node_id")
  status             StepStatus @default(pending)
  assignedRoleId     String     @map("assigned_role_id") @db.Uuid
  dueAt              DateTime?  @map("due_at") @db.Timestamptz(6)
  escalatedToRoleId  String?    @map("escalated_to_role_id") @db.Uuid
  /** Set by the worker once approvers were notified of this (re)assignment. */
  notifiedAt         DateTime?  @map("notified_at") @db.Timestamptz(6)
  /** Set by the worker when the SLA breach was handled (escalated or flagged). */
  slaBreachedAt      DateTime?  @map("sla_breached_at") @db.Timestamptz(6)
  completedAt        DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  request Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actions StepAction[]
  approvalTokens ApprovalToken[]

  @@index([tenantId, status])
  @@index([status, dueAt])
  @@index([requestId])
  @@map("request_steps")
}

model StepAction {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  stepId         String         @map("step_id") @db.Uuid
  actorUserId    String         @map("actor_user_id") @db.Uuid
  action         StepActionType
  comment        String?
  /** delegate: who the step was delegated to. */
  targetUserId   String?        @map("target_user_id") @db.Uuid
  /** OOO delegation: the role member the actor acted for. */
  onBehalfOfUserId String?      @map("on_behalf_of_user_id") @db.Uuid
  /** How this action reached us: web session, no-login email/whatsapp link, api, tally. */
  channel        ApprovalChannel @default(web)
  actedAt        DateTime       @default(now()) @map("acted_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  step   RequestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("step_actions")
}

// A single-use, signed link that lets a named approver act on one step without
// logging in. The raw token travels only in the email/WhatsApp URL; we store
// just its sha256. Consuming it is atomic (see ApprovalTokensService.consume):
// `consumed_at` is claimed with `WHERE consumed_at IS NULL`, so a token can be
// spent exactly once even under concurrent taps.
model ApprovalToken {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  stepId            String           @map("step_id") @db.Uuid
  /** The approver this link authenticates as — the action is attributed to them. */
  userId            String           @map("user_id") @db.Uuid
  /** sha256(rawToken). The raw token itself is never persisted. */
  tokenHash         String           @unique @map("token_hash")
  /** email | whatsapp — the delivery surface this link was minted for. */
  channel           ApprovalChannel
  /** Which actions this link permits, e.g. [approve, reject]. */
  allowedActions    StepActionType[] @map("allowed_actions")
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?        @map("consumed_at") @db.Timestamptz(6)
  consumedAction    StepActionType?  @map("consumed_action")
  consumedIp        String?          @map("consumed_ip")
  consumedUserAgent String?          @map("consumed_user_agent")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  step   RequestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([tenantId])
  @@map("approval_tokens")
}

// Out-of-office delegation window: to_user may act wherever from_user could.
model Delegation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, toUserId])
  @@index([tenantId, fromUserId])
  @@map("delegations")
}

// Where signed webhooks go. `events` filters event types; empty = all events.
model WebhookEndpoint {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  description String?
  events      String[] @default([])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  outbox WebhookOutbox[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

// Transactional outbox: rows are written in the SAME transaction as the state
// change they announce; the worker delivers them with exponential backoff
// (1m, 5m, 30m, 2h, 12h) and dead-letters after the schedule is exhausted.
model WebhookOutbox {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  /** Null for workflow webhook_call nodes that target an inline URL. */
  endpointId     String?             @map("endpoint_id") @db.Uuid
  /** Delivery target, snapshotted at enqueue time. */
  url            String
  eventType      String              @map("event_type")
  payload        Json
  status         WebhookOutboxStatus @default(pending)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /** Delivery lease — a crashed worker's claim expires after 5 minutes. */
  lockedAt       DateTime?           @map("locked_at") @db.Timestamptz(6)
  lastError      String?             @map("last_error")
  lastStatusCode Int?                @map("last_status_code")
  deliveredAt    DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  endpoint WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, endpointId, createdAt])
  @@map("webhook_outbox")
}

// Machine credentials: `ax_<64 hex>`, sha256 stored, plaintext shown exactly once.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /** First characters of the key, kept for display ("ax_3f9a…"). */
  prefix      String
  keyHash     String    @unique @map("key_hash")
  scopes      String[]  @default([])
  createdById String    @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("api_keys")
}

// Append-only. A Postgres trigger (phase1_rls_audit migration) raises an
// exception on UPDATE, DELETE, or TRUNCATE. No updated_at by design.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorType   String   @default("user") @map("actor_type")
  eventType   String   @map("event_type")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}
