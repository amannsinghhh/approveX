{
  "name": "@approvex/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @approvex/shared build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @approvex/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @approvex/shared build",
    "test": "vitest run"
  },
  "dependencies": {
    "@approvex/shared": "workspace:*",
    "@prisma/client": "catalog:",
    "bullmq": "^5.34.0",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
