{
  "name": "@approvex/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @approvex/shared build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @approvex/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @approvex/shared build",
    "test": "vitest run"
  },
  "dependencies": {
    "@approvex/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.34.0",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
