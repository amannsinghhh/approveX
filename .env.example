# Copy to .env (and apps/api/.env for local dev) — docker compose injects its own values.

# Owner connection: migrations, auth bootstrap, system writes (bypasses RLS).
DATABASE_URL=postgresql://approvex:approvex@localhost:5432/approvex?schema=public
# App connection: non-owner role, RLS always enforced. Password is a dev default —
# override in production with: ALTER ROLE approvex_app PASSWORD '...'
APP_DATABASE_URL=postgresql://approvex_app:approvex_app@localhost:5432/approvex?schema=public

REDIS_URL=redis://localhost:6379
PORT=3000

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m

# Rate limiting (per tenant, rolling minute) on POST /evaluate and POST /requests.
# RATE_LIMIT_RPM=300

# Public URLs (OIDC redirects + SSO landing). Defaults suit local dev.
# API_PUBLIC_URL=http://localhost:3000
# WEB_APP_URL=http://localhost:5199

# SSO — a provider is enabled only when both values are set.
# Redirect URI to register: {API_PUBLIC_URL}/api/v1/auth/oidc/<provider>/callback
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=common

# Email notifications (worker). Without a key the worker logs instead of sending.
# RESEND_API_KEY=
# MAIL_FROM=ApproveX <notifications@yourdomain.com>

# Error monitoring — a no-op when unset.
# SENTRY_DSN=

# Production only (docker-compose.prod.yml): see docs/DEPLOYMENT.md
# APPROVEX_DOMAIN=approvals.yourcompany.com
# POSTGRES_PASSWORD=
# APP_DB_PASSWORD=
