# Production image (Phase 7): one build, three roles — the api and worker
# services run this image with different commands, and the web bundle is
# copied out of it into the volume Caddy serves.
FROM node:22-alpine
WORKDIR /app
RUN corepack enable pnpm

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @approvex/shared build \
  && pnpm --filter @approvex/api exec prisma generate \
  && pnpm --filter @approvex/api build \
  && pnpm --filter @approvex/worker build \
  && pnpm --filter @approvex/web build

ENV NODE_ENV=production
# default role: API (compose overrides for worker / assets)
CMD ["node", "apps/api/dist/main.js"]
