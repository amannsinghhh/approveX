# Production image: one dependency install + build, exposed as two runtime
# targets — `api` and `worker`. Dokploy builds each with its own --target.
#
# The web SPA is NOT built here; it has its own image (Dockerfile.web, nginx).
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable pnpm

# Manifest first so the dependency layer caches independently of source edits.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

COPY . .
RUN pnpm prisma:generate && pnpm build:server
ENV NODE_ENV=production

# ---- API: apply migrations, then serve HTTP on 3000 ----
FROM build AS api
EXPOSE 3000
CMD ["sh", "-c", "pnpm prisma:deploy && node dist/apps/api/src/main.js"]

# ---- Worker: background webhooks + timers, no exposed port ----
FROM build AS worker
CMD ["node", "dist/apps/worker/src/main.js"]
