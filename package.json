{
  "name": "approvex",
  "version": "0.1.0",
  "private": true,
  "description": "ApproveX — rules and approval workflows as an API",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "pnpm dev:api & pnpm dev:worker & pnpm dev:web & wait",
    "dev:api": "nest start --watch",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "seed": "tsx apps/api/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^10.64.0",
    "@tailwindcss/vite": "^4.3.2",
    "@xyflow/react": "^12.11.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
